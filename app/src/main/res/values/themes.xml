<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Invernadero" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/inv_primary</item>
        <item name="colorOnPrimary">@color/inv_on_primary</item>
        <item name="colorPrimaryContainer">@color/inv_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/inv_on_primary_container</item>
        <item name="colorSecondary">@color/inv_secondary</item>
        <item name="colorOnSecondary">@color/inv_on_secondary</item>
        <item name="colorSecondaryContainer">@color/inv_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/inv_on_secondary_container</item>
        <item name="colorError">@color/inv_error</item>
        <item name="colorOnError">@color/inv_on_error</item>
        <item name="android:colorBackground">@color/inv_background</item>
        <item name="colorOnBackground">@color/inv_on_surface</item>
        <item name="colorSurface">@color/inv_surface</item>
        <item name="colorOnSurface">@color/inv_on_surface</item>
        <item name="colorSurfaceVariant">@color/inv_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/inv_on_surface_variant</item>
        <item name="colorOutline">@color/inv_outline</item>
        <item name="colorSurfaceContainer">@color/inv_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/inv_surface_container_high</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Inv.Medium</item>
    </style>

    <style name="Theme.Invernadero.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/inv_primary_container</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Invernadero</item>
    </style>

    <style name="ShapeAppearance.Inv.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Inv.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.Inv.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <style name="TextAppearance.Inv.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Inv.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
